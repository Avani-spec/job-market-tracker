# Scrape new HN postings every day at 06:15 and rebuild the report on Mondays.
15 6 * * *  cd /path/to/job-market-tracker && . .venv/bin/activate && set -a && . ./.env && jobtracker scrape hn --months 1 >> logs/scrape.log 2>&1
30 6 * * 1  cd /path/to/job-market-tracker && . .venv/bin/activate && set -a && . ./.env && jobtracker report --out reports/ >> logs/report.log 2>&1
